# Copy this file to .env.local (never commit .env.local):
#   cp .env.local.example .env.local
#
# Use straight quotes only when editing — not curly ‘ ’ quotes.

ADMIN_USER=coach
ADMIN_PASS=replace-with-your-local-coach-password
JWT_SECRET=replace-with-any-long-random-string-for-local-dev

# Optional for full checkout / email testing:
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_MODE=sandbox
# PUBLIC_URL=http://localhost:3000

# Optional override for payment error alert CC (defaults to Robertraimondi@gmail.com):
# PAYMENT_ERROR_CC=Robertraimondi@gmail.com

# Outbound email — Gmail SMTP (automated receipts, waitlist invites, broadcasts)
# Use a Google App Password (not your normal Gmail password):
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=benstadeyhockey@gmail.com
EMAIL_PASS=your-16-char-google-app-password

# Parents see this on the site and can reply here; SMTP still sends via EMAIL_USER above.
CONTACT_EMAIL=ben@benstadeyhockey.com
# EMAIL_FROM_NAME=Ben Stadey Hockey Training
